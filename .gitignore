
# .gitignore patterns
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■

# Allowlist strategy: ignore everything, then explicitly allow what belongs.
# This prevents accidental commits of new files or folders.
#
# Pattern reference:
#   /foo    — root only
#   foo/    — folders only
#   *       — any chars (no /)
#   ?       — any single char (no /)
#   **/     — any depth of folders
#   /**     — everything inside
#   a/**/b — anything between a and b

# .gitignore rules
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■

# ignore ALL files & folders
*

# Whitelist
# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬

# project files
# ——————————————————————————————

!/LICENSE

# .gitignore, .gitattributes, .gitmodules
!/.git?*

# non-hidden files
!/*.*

# coding agents
# ——————————————————————————————

!/.agent*/
!/.agent*/**

!/.claude*/
!/.claude*/**

# source code
# ——————————————————————————————

!/src
!/src/**

# monorepo workspace folders
# ------------------------------

!/apps/
!/apps/**

!/packages/
!/packages/**

!/plugins/
!/plugins/**

!/utils/
!/utils/**

# Blacklist
# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬

# dependencies
# ——————————————————————————————

**/node_modules/
**/roku_modules/

# artifacts
# ——————————————————————————————

**/.artifacts/
**/build/
**/dist/
**/out/

# coding agents
# ——————————————————————————————

**/.claude/settings.local.json

**/agent.local.md
**/claude.local.md
